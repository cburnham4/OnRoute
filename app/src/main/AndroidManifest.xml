<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
         ACCESS_FINE_LOCATION is required for My Location and Places Find Current Place.
         INTERNET is required for Maps, Places, and Directions API calls (HTTPS).
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/icon_pin114"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/MyMaterialTheme"
        android:usesCleartextTraffic="false">

        <!--
             Maps / Places / Directions API key is injected at build time from
             local.properties (MAPS_API_KEY). See local.properties.example.
        -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key" />

        <activity
            android:name=".Activities.Activity_Maps"
            android:exported="true"
            android:label="@string/title_activity_maps"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Activities.Activity_DirectionsList"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Activities.Activity_CreateRoute"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>

</manifest>
